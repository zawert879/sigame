{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SI Game",
  "version": "1.0.0",
  "identifier": "app.sigame.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SI Game",
        "width": 480,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "SI Game",
    "category": "TriviaGame",
    "shortDescription": "Своя игра для компании в одной сети",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sigame-server"],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
