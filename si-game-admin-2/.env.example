# Address of si-game-service (socket.io, REST API and pack media) for `yarn dev`.
# Copy this file to .env.development.local: Next loads it for `next dev` only. Do not use .env.local or .env —
# `next build` reads them too and would bake this address into the static export, while in production the frontend is
# served by the service itself and must use the page origin (the variable empty / not set).
# A value without a protocol ("localhost:4000") is treated as http://.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
